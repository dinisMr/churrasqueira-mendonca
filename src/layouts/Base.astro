---
import '../styles/global.css';
import {
  info,
  ementa,
  precoPublicavel,
  horario,
  nomeProduto,
  descricaoProduto,
  nomeCategoria,
} from '../lib/catalogo';
import { textos, linguas, diaEmIngles, type Lingua } from '../i18n/textos';

interface Props {
  titulo: string;
  descricao: string;
  lingua: Lingua;
}
const { titulo, descricao, lingua } = Astro.props;
const t = textos[lingua];
const htmlLang = linguas.find((l) => l.codigo === lingua)?.html ?? 'pt-PT';
// hreflang exige URLs absolutos: só com "url_site" preenchido.
const alternativas = Astro.site
  ? linguas.map((l) => ({ hreflang: l.html, href: new URL(l.caminho, Astro.site).href }))
  : [];

// Só há URL absoluto quando "url_site" está preenchido em estabelecimento.json.
const urlCanonico = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;

const horarioSchema = horario
  .map((d) => ({ ...d, schema: diaEmIngles(d.dia) }))
  .filter((d) => d.schema && d.abre && d.fecha)
  .map((d) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: `https://schema.org/${d.schema}`,
    opens: d.abre,
    closes: d.fecha,
  }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: info.nome,
  ...(urlCanonico ? { url: urlCanonico, '@id': `${urlCanonico}#restaurante` } : {}),
  telephone: info.telefone_e164,
  servesCuisine: t.meta.cozinha,
  address: {
    '@type': 'PostalAddress',
    streetAddress: info.morada.rua,
    postalCode: info.morada.codigo_postal,
    addressLocality: info.morada.localidade,
    addressRegion: info.morada.concelho,
    addressCountry: info.morada.pais,
  },
  areaServed: [info.morada.localidade, info.morada.concelho],
  hasMap: info.google_maps,
  sameAs: [info.instagram],
  ...(info.pagamentos.length ? { paymentAccepted: info.pagamentos.join(', ') } : {}),
  ...(horarioSchema.length ? { openingHoursSpecification: horarioSchema } : {}),
  hasMenu: {
    '@type': 'Menu',
    inLanguage: htmlLang,
    hasMenuSection: ementa.map((c) => ({
      '@type': 'MenuSection',
      name: nomeCategoria(c, lingua),
      hasMenuItem: c.produtos.map((p) => {
        const preco = precoPublicavel(p);
        return {
          '@type': 'MenuItem',
          name: nomeProduto(p, lingua),
          ...(descricaoProduto(p, lingua) ? { description: descricaoProduto(p, lingua) } : {}),
          ...(preco !== null
            ? {
                offers: {
                  '@type': 'Offer',
                  price: preco.toFixed(2),
                  priceCurrency: 'EUR',
                },
              }
            : {}),
        };
      }),
    })),
  },
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta name="theme-color" content="#212121" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    {urlCanonico && <link rel="canonical" href={urlCanonico} />}
    {alternativas.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {alternativas[0] && <link rel="alternate" hreflang="x-default" href={alternativas[0].href} />}

    <meta property="og:type" content="restaurant" />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta property="og:site_name" content={info.nome} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    {urlCanonico && <meta property="og:url" content={urlCanonico} />}
    <meta name="twitter:card" content="summary" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[60] focus:rounded-md focus:bg-papel focus:px-4 focus:py-2 focus:font-semibold focus:text-tinta"
    >
      {t.meta.saltar}
    </a>
    <slot />
  </body>
</html>
