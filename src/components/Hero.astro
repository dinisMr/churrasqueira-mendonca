---
import Icone from './Icone.astro';
import { Image } from 'astro:assets';
import { info, moradaLinha1 } from '../lib/catalogo';
import { capa } from '../lib/fotos';
---

<section id="topo" class="relative isolate overflow-hidden bg-carvao text-creme">
  {
    /* Fotografia de capa (src/assets/fotos/capa.*), escurecida para manter o texto legível. */
    capa && (
      <>
        <Image
          src={capa.imagem}
          alt=""
          widths={[640, 960, 1280, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 -z-20 h-full w-full object-cover object-[70%_center]"
        />
        <div
          aria-hidden="true"
          class="absolute inset-0 -z-20 bg-gradient-to-t from-carvao via-carvao/85 to-carvao/60 md:bg-gradient-to-r md:from-carvao md:via-carvao/85 md:to-carvao/25"
        />
      </>
    )
  }
  {
    !capa && (
      <div
        aria-hidden="true"
        class="madeira absolute inset-0 -z-10"
      />
    )
  }

  <div class="contentor py-20 md:py-32">
    <p class="sobretitulo flex items-center gap-3 text-amarelo">
      <span class="h-px w-8 bg-amarelo"></span>
      {info.morada.localidade} · {info.morada.concelho}
    </p>

    <h1 class="mt-5 max-w-3xl text-5xl leading-[1.05] font-bold sm:text-7xl md:text-8xl">
      O sabor do churrasco, <span class="text-amarelo">perto de si</span>
    </h1>

    <p class="mt-6 max-w-xl text-lg text-creme/85">
      Frango no churrasco, entrecosto, choco frito e menus completos para levar para casa, na{' '}
      {info.nome}.
    </p>

    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a href="#ementa" class="botao botao-principal">
        Ver ementa
        <Icone nome="seta" class="h-4 w-4" />
      </a>
      <a href="#contactos" class="botao botao-claro">
        <Icone nome="mapa" class="h-4 w-4" />
        Contactos e localização
      </a>
    </div>

    <ul class="mt-12 flex flex-col gap-x-8 gap-y-3 text-sm text-creme/85 sm:flex-row sm:flex-wrap">
      <li class="flex items-center gap-2">
        <Icone nome="saco" class="h-4 w-4 text-amarelo" />
        Take-away
      </li>
      <li class="flex items-center gap-2">
        <Icone nome="mapa" class="h-4 w-4 text-amarelo" />
        {moradaLinha1}, {info.morada.localidade}
      </li>
      <li class="flex items-center gap-2">
        <Icone nome="telefone" class="h-4 w-4 text-amarelo" />
        {info.telefone_display}
      </li>
    </ul>
  </div>
</section>
<div class="tijolo" aria-hidden="true"></div>
