---
import Icone from './Icone.astro';
import { Image } from 'astro:assets';
import { info, moradaLinha1 } from '../lib/catalogo';
import { capa } from '../lib/fotos';
import { textos, type Lingua } from '../i18n/textos';

interface Props {
  lingua: Lingua;
}
const { lingua } = Astro.props;
const t = textos[lingua];
---

<section id="topo" class="relative isolate overflow-hidden bg-carvao text-creme">
  {
    /* Fotografia de capa (src/assets/fotos/capa.*), escurecida para manter o texto legível. */
    capa && (
      <>
        <Image
          src={capa.imagem}
          alt=""
          widths={[640, 960, 1280, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 -z-20 h-full w-full object-cover"
        />
        <div
          aria-hidden="true"
          class="absolute inset-0 -z-20 bg-gradient-to-r from-carvao/95 via-carvao/80 to-carvao/45"
        />
      </>
    )
  }
  <!-- Brilho dourado: fundo decorativo em CSS. -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10"
    style="background:
      radial-gradient(60rem 28rem at 85% 110%, rgb(248 184 32 / 0.22), transparent 65%),
      radial-gradient(34rem 20rem at 8% 105%, rgb(248 184 32 / 0.10), transparent 70%),
      radial-gradient(40rem 30rem at 50% -20%, rgb(255 255 255 / 0.05), transparent 70%);"
  >
  </div>
  <!-- Grelha -->
  <div
    aria-hidden="true"
    class="absolute inset-x-0 bottom-0 -z-10 h-40 opacity-[0.13]"
    style="background-image: repeating-linear-gradient(90deg, #f8f4eb 0 3px, transparent 3px 34px);
      mask-image: linear-gradient(to top, #000, transparent);
      -webkit-mask-image: linear-gradient(to top, #000, transparent);"
  >
  </div>

  <div class="contentor py-20 md:py-32">
    <p class="sobretitulo flex items-center gap-3 text-galo">
      <span class="h-px w-8 bg-galo"></span>
      {info.morada.localidade} · {info.morada.concelho}
    </p>

    <h1 class="mt-5 max-w-3xl text-[2.6rem] leading-[1.05] font-semibold tracking-tight sm:text-6xl md:text-7xl">
      {t.hero.tituloA} <span class="text-galo">{t.hero.tituloB}</span>
    </h1>

    <p class="mt-6 max-w-xl text-lg text-creme/85">
      {t.hero.texto(info.nome)}
    </p>

    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a href="#ementa" class="botao botao-principal">
        {t.hero.verEmenta}
        <Icone nome="seta" class="h-4 w-4" />
      </a>
      <a href="#contactos" class="botao botao-claro">
        <Icone nome="mapa" class="h-4 w-4" />
        {t.hero.contactos}
      </a>
    </div>

    <ul class="mt-12 flex flex-col gap-x-8 gap-y-3 text-sm text-creme/85 sm:flex-row sm:flex-wrap">
      <li class="flex items-center gap-2">
        <Icone nome="saco" class="h-4 w-4 text-galo" />
        {t.hero.takeaway}
      </li>
      <li class="flex items-center gap-2">
        <Icone nome="mapa" class="h-4 w-4 text-galo" />
        {moradaLinha1}, {info.morada.localidade}
      </li>
      <li class="flex items-center gap-2">
        <Icone nome="telefone" class="h-4 w-4 text-galo" />
        {info.telefone_display}
      </li>
    </ul>
  </div>
</section>
