---
import {
  ementa,
  embalagens,
  precoPublicavel,
  formatarPreco,
  sufixoUnidade,
  nomeProduto,
  descricaoProduto,
  nomeCategoria,
  notaCategoria,
  type Produto,
} from '../lib/catalogo';
import { textos, type Lingua } from '../i18n/textos';

interface Props {
  lingua: Lingua;
}
const { lingua } = Astro.props;
const t = textos[lingua];

const SOB_CONSULTA = t.ementa.sobConsulta;

// Sacos: se todos custam o mesmo mostra-se um só preço; caso contrário, um por tamanho.
const precosSacos = embalagens.map((p) => precoPublicavel(p) as number);
const textoSacos =
  new Set(precosSacos).size === 1
    ? formatarPreco(precosSacos[0] as number, lingua)
    : embalagens
        .map(
          (p) =>
            `${nomeProduto(p, lingua).replace(/^Saco\s+|\s+bag$/gi, '').toLowerCase()} ${formatarPreco(precoPublicavel(p) as number, lingua)}`,
        )
        .join(' · ');

function preco(p: Produto) {
  const valor = precoPublicavel(p);
  return valor === null ? null : { texto: formatarPreco(valor, lingua), sufixo: sufixoUnidade(p) };
}
---

<section id="ementa" class="py-16 md:py-24">
  <div class="contentor">
    <p class="sobretitulo text-cobre-forte">{t.ementa.sobretitulo}</p>
    <h2 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">{t.ementa.titulo}</h2>
    <p class="mt-4 max-w-2xl text-tinta-suave">
      {t.ementa.intro}
    </p>
  </div>

  <!-- Atalhos por categoria -->
  <nav
    aria-label={t.ementa.categorias}
    class="sticky top-[6.55rem] z-40 mt-8 border-y border-linha bg-creme/95 backdrop-blur md:top-16"
  >
    <ul class="contentor sem-barra flex gap-2 overflow-x-auto py-3">
      {
        ementa.map((c) => (
          <li class="shrink-0">
            <a
              href={`#${c.id}`}
              class="block rounded-full border border-linha bg-papel px-4 py-2 text-sm font-semibold whitespace-nowrap transition-colors hover:border-cobre-forte hover:text-cobre-forte"
            >
              {nomeCategoria(c, lingua)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="contentor">
    {
      ementa.map((c) => (
        <section id={c.id} aria-labelledby={`${c.id}-titulo`} class="pt-14">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b-2 border-tinta pb-3">
            <h3 id={`${c.id}-titulo`} class="text-2xl font-semibold tracking-tight md:text-3xl">
              {nomeCategoria(c, lingua)}
            </h3>
            {notaCategoria(c, lingua) && (
              <p class="text-sm text-tinta-suave">{notaCategoria(c, lingua)}</p>
            )}
          </div>

          {c.formato === 'cartoes' ? (
            <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {c.produtos.map((p) => {
                const v = preco(p);
                return (
                  <li class="flex flex-col rounded-2xl border border-linha bg-papel p-5">
                    <h4 class="font-display text-xl leading-snug font-semibold">{nomeProduto(p, lingua)}</h4>
                    {descricaoProduto(p, lingua) && (
                      <p class="mt-2 flex-1 text-sm text-tinta-suave">{descricaoProduto(p, lingua)}</p>
                    )}
                    <p class="mt-5 border-t border-linha pt-3">
                      {v ? (
                        <span class="preco text-2xl">
                          {v.texto}
                          {v.sufixo && <span class="text-base font-medium">{v.sufixo}</span>}
                        </span>
                      ) : (
                        <span class="text-sm font-semibold text-tinta-suave">{SOB_CONSULTA}</span>
                      )}
                    </p>
                  </li>
                );
              })}
            </ul>
          ) : (
            <ul class="mt-2 grid gap-x-14 md:grid-cols-2">
              {c.produtos.map((p) => {
                const v = preco(p);
                return (
                  <li class="border-b border-linha py-4">
                    <div class="flex items-baseline gap-3">
                      <h4 class="text-[1.05rem] font-semibold">{nomeProduto(p, lingua)}</h4>
                      <span class="pontilhado" aria-hidden="true" />
                      {v ? (
                        <span class="preco text-lg">
                          {v.texto}
                          {v.sufixo && <span class="text-sm font-medium">{v.sufixo}</span>}
                        </span>
                      ) : (
                        <span class="text-sm font-semibold whitespace-nowrap text-tinta-suave">
                          {SOB_CONSULTA}
                        </span>
                      )}
                    </div>
                    {descricaoProduto(p, lingua) && (
                      <p class="mt-1 text-sm text-tinta-suave">{descricaoProduto(p, lingua)}</p>
                    )}
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      ))
    }

    <div class="mt-12 rounded-2xl bg-creme-escuro p-6 md:p-8">
      <div class="text-sm text-tinta-suave">
        <p>
          <strong class="text-tinta">“{SOB_CONSULTA}”</strong> {t.ementa.notaSobConsulta}
        </p>
        {
          embalagens.length > 0 && (
            <p class="mt-2">
              {t.ementa.sacos}:{' '}
              {textoSacos}.
            </p>
          )
        }
      </div>
    </div>
  </div>
</section>
