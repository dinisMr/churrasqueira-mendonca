---
import Icone from './Icone.astro';
import { info } from '../lib/catalogo';
import { textos, type Lingua } from '../i18n/textos';

interface Props {
  lingua: Lingua;
}
const { lingua } = Astro.props;
const t = textos[lingua];

// Apenas factos confirmados no material fornecido — sem história inventada.
const destaques = [{ icone: 'chama' as const }, { icone: 'saco' as const }, { icone: 'relogio' as const }];
---

<section id="sobre" class="bg-carvao py-16 text-creme md:py-24">
  <div class="contentor grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
    <div>
      <p class="sobretitulo text-galo">{t.sobre.sobretitulo}</p>
      <h2 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">
        {t.sobre.titulo(info.morada.localidade)}
      </h2>
      <p class="mt-6 text-lg text-creme/85">
        {t.sobre.p1(info.nome, info.morada.rua, info.morada.zona, info.morada.concelho)}
      </p>
      <p class="mt-4 text-creme/85">
        {t.sobre.p2}
      </p>
    </div>

    <ul class="grid gap-4">
      {
        destaques.map((d, i) => (
          <li class="flex gap-4 rounded-2xl border border-white/10 bg-carvao-suave p-5 md:p-6">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-cobre-forte">
              <Icone nome={d.icone} class="h-5 w-5" />
            </span>
            <div>
              <h3 class="text-xl font-semibold">{t.sobre.destaques[i]?.titulo}</h3>
              <p class="mt-1 text-creme/80">{t.sobre.destaques[i]?.texto}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
